#usda 1.0
(
    defaultPrim = "LaunchPad"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 180
    timeCodesPerSecond = 30
    framesPerSecond = 30
)
def Xform "LaunchPad" (
    kind = "component"
    documentation = "Original UAV launch/landing pad; 12 x 12 m deck; landing surface Y=0; +Z approach."
    customData = {
        string assetID = "uav-launch-pad"
        string design = "Original visual concept; no claim of regulatory approval or load rating"
        double landingSurfaceY = 0
        double deckWidthM = 12
        double deckLengthM = 12
    }
)
{
    def Scope "Materials"
    {
        def Material "asphalt"
        {
            token outputs:surface.connect = </LaunchPad/Materials/asphalt/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:roughness = 0.96
                float inputs:metallic = 0
                color3f inputs:diffuseColor.connect = </LaunchPad/Materials/asphalt/Texture.outputs:rgb>
                token outputs:surface
            }
            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/asphalt.png@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </LaunchPad/Materials/asphalt/UV.outputs:result>
                float3 outputs:rgb
            }
        }
